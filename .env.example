VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=la-tua-chiave-anon-pubblica

# Usata solo lato server (api/genera-descrizione.js) per generare descrizioni con l'IA.
# Non deve avere il prefisso VITE_ altrimenti finirebbe nel bundle pubblico del sito.
ANTHROPIC_API_KEY=sk-ant-...

# Token pubblico Mapbox (mapbox.com > Account > Tokens), usato lato client per
# geocodificare il luogo dell'evento e generare la mappa di fallback quando
# l'organizzatore non carica una foto.
VITE_MAPBOX_TOKEN=pk....

# API key Google Cloud (console.cloud.google.com, con Places API e Maps JavaScript
# API abilitate) usata lato client per i suggerimenti indirizzo nel campo Luogo.
# Consigliato restringerla per referrer HTTP al proprio dominio.
VITE_GOOGLE_MAPS_KEY=AIza...
