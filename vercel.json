{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "fomoas.vercel.app" }],
      "destination": "https://www.fomoas.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/policy", "destination": "/index.html" },
    { "source": "/evento/(.*)", "destination": "/index.html" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/api/today-events.json", "destination": "/api/today-events" }
  ],
  "functions": {
    "api/eventi-vicino-a-me.js": {
      "maxDuration": 150
    },
    "api/eventi-dal-web.js": {
      "maxDuration": 300
    }
  }
}
